<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AlarmIgnore" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorOnPrimary">@color/on_brand</item>
    </style>

    <!-- Used by the invisible trampoline activity so nothing is drawn on screen.
         Based on the pure framework translucent theme (no AppCompat needed). -->
    <style name="Theme.AlarmIgnore.Transparent" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
